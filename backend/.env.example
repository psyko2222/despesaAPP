PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
DATABASE_PATH=/data/despesas.db
CORS_ORIGIN=https://your-frontend-url.railway.app

# Email — use SendGrid OU SMTP (obrigatório para recuperação de password)
# SendGrid: o FROM tem de ser um remetente verificado no SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@oseudominio.com

# Alternativa SMTP (ex.: Gmail com App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@oseudominio.com

FRONTEND_URL=https://despesa-app.vercel.app
